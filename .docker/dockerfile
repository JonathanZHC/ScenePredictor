# Isaac Sim 6.0.1 + ROS 2 Jazzy + RTX 5090/Blackwell ScenePredictor image.
# Build context must be the ScenePredictor repository root.
# Before building: git submodule update --init --recursive

ARG ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.0.1
ARG CUDA_BUILDER_IMAGE=nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04

ARG TORCH_VERSION=2.11.0
ARG TORCHVISION_VERSION=0.26.0
ARG WARP_VERSION=1.15.0
ARG ULTRALYTICS_VERSION=8.4.115
ARG TENSORRT_VERSION=10.14.1.48.post1
ARG TORCH_CUDA_ARCH_LIST=12.0

# =============================================================================
# Stage 1: build the local DifFlow3D PointNet++ CUDA extension.
# =============================================================================
FROM ${CUDA_BUILDER_IMAGE} AS difflow-builder

ARG DEBIAN_FRONTEND=noninteractive
ARG TORCH_VERSION
ARG TORCH_CUDA_ARCH_LIST

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=1 \
    MAX_JOBS=4 \
    LD_LIBRARY_PATH=/opt/difflow-build-venv/lib/python3.12/site-packages/torch/lib:/usr/local/cuda/lib64

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      ninja-build \
      python3 \
      python3-dev \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/difflow-build-venv \
    PATH=/opt/difflow-build-venv/bin:${PATH}

RUN /usr/bin/python3 -m venv "${VIRTUAL_ENV}" \
    && python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install \
      torch==${TORCH_VERSION} \
      --index-url https://download.pytorch.org/whl/cu128

COPY DifFlow3D/ /opt/DifFlow3D/

RUN test -d /opt/DifFlow3D/pointnet2/src \
    && test -f /opt/DifFlow3D/pretrain_weights/model_difflow_355_0.0114.pth \
    && test "$(stat -c '%s' /opt/DifFlow3D/pretrain_weights/model_difflow_355_0.0114.pth)" -gt 1000000

# Modern PyTorch/CUDA API compatibility edits. The CUDA mathematics is unchanged.
RUN python3 - <<'PY'
from pathlib import Path
import re

repo = Path('/opt/DifFlow3D')
src_dir = repo / 'pointnet2' / 'src'
for path in sorted(src_dir.glob('*')):
    if path.suffix not in {'.cpp', '.cu', '.h', '.hpp'}:
        continue
    text = path.read_text(encoding='utf-8')
    original = text
    text = re.sub(r'^\s*#include\s*[<"]THC/THC\.h[>"]\s*$\n?', '', text, flags=re.MULTILINE)
    text = re.sub(r'^\s*extern\s+THCState\s*\*\s*state\s*;\s*$\n?', '', text, flags=re.MULTILINE)
    text = re.sub(r'\.data\s*<\s*([^>]+?)\s*>\s*\(\s*\)', r'.data_ptr<\1>()', text)
    text = text.replace('.type().is_cuda()', '.is_cuda()')
    if 'getCurrentCUDAStream' in text:
        text = text.replace('at::cuda::getCurrentCUDAStream()', 'c10::cuda::getCurrentCUDAStream().stream()')
        text = text.replace('c10::cuda::getCurrentCUDAStream()', 'c10::cuda::getCurrentCUDAStream().stream()')
        text = text.replace('c10::cuda::getCurrentCUDAStream().stream().stream()', 'c10::cuda::getCurrentCUDAStream().stream()')
        include = '#include <c10/cuda/CUDAStream.h>'
        if include not in text:
            lines = text.splitlines()
            insert_at = 0
            for index, line in enumerate(lines):
                if line.lstrip().startswith('#include'):
                    insert_at = index + 1
                elif insert_at:
                    break
            lines.insert(insert_at, include)
            text = '\n'.join(lines) + ('\n' if original.endswith('\n') else '')
    if text != original:
        path.write_text(text, encoding='utf-8')
        print('patched', path.relative_to(repo))
PY

RUN python3 -m pip install numpy==1.26.4 \
    && cd /opt/DifFlow3D/pointnet2 \
    && rm -rf build pointnet2_cuda*.so \
    && python3 setup.py build_ext --inplace \
    && cd /opt/DifFlow3D \
    && PYTHONPATH=/opt/DifFlow3D:/opt/DifFlow3D/pointnet2 python3 - <<'PY'
import pointnet2_cuda
from pointnet2 import pointnet2_utils
print('pointnet2_cuda:', pointnet2_cuda.__file__)
print('pointnet2_utils:', pointnet2_utils.__file__)
PY

RUN python3 - <<'PY'
from pathlib import Path
import shutil

candidates = sorted(Path('/usr/local/cuda').rglob('libcudart.so.12'))
if not candidates:
    raise FileNotFoundError('libcudart.so.12 not found')
out = Path('/opt/difflow-cuda-runtime/lib')
out.mkdir(parents=True, exist_ok=True)
shutil.copy2(candidates[0].resolve(), out / 'libcudart.so.12')
PY

# =============================================================================
# Stage 2: official Isaac Sim runtime.
# =============================================================================
FROM ${ISAAC_SIM_IMAGE}

USER root

ARG DEBIAN_FRONTEND=noninteractive
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG WARP_VERSION
ARG ULTRALYTICS_VERSION
ARG TENSORRT_VERSION
ARG TORCH_CUDA_ARCH_LIST

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONNOUSERSITE=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    FORCE_CUDA=1 \
    MAX_JOBS=4 \
    ISAAC_SIM_PATH=/isaac-sim \
    DIFFLOW_REPO=/opt/DifFlow3D \
    ROS_DISTRO=jazzy \
    ROS_DOMAIN_ID=117 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    ACCEPT_EULA=Y \
    PRIVACY_CONSENT=Y \
    OMNICLIENT_HUB_MODE=disabled \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all \
    HOME=/isaac-sim \
    YOLO_CONFIG_DIR=/isaac-sim/.config/Ultralytics \
    MPLCONFIGDIR=/isaac-sim/.cache/matplotlib \
    HF_HOME=/isaac-sim/.cache/huggingface \
    TORCH_HOME=/isaac-sim/.cache/torch \
    PATH=/opt/difflow-python-packages/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg2 locales lsb-release software-properties-common \
      python3 python3-dev \
      libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libx11-6 \
      libxrandr2 libxinerama1 libxcursor1 libxi6 xauth mesa-utils libgomp1 \
    && locale-gen en_US.UTF-8 \
    && curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo ${UBUNTU_CODENAME}) main" \
      > /etc/apt/sources.list.d/ros2.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      ros-jazzy-ros-base \
      ros-jazzy-rmw-fastrtps-cpp \
      ros-jazzy-geometry-msgs \
      ros-jazzy-sensor-msgs \
      ros-jazzy-sensor-msgs-py \
      ros-jazzy-std-msgs \
      ros-jazzy-visualization-msgs \
      ros-jazzy-message-filters \
      ros-jazzy-cv-bridge \
      ros-jazzy-tf2-ros \
      ros-jazzy-tf2-tools \
      ros-jazzy-tf2-geometry-msgs \
      ros-jazzy-rviz2 \
      ros-jazzy-image-transport-plugins \
      python3-colcon-common-extensions \
      python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# Keep the ML stack isolated from Isaac Sim's own packages.
RUN mkdir -p /opt/difflow-python-packages \
    && /isaac-sim/python.sh -m pip install \
      --no-cache-dir \
      --target /opt/difflow-python-packages \
      torch==${TORCH_VERSION} \
      torchvision==${TORCHVISION_VERSION} \
      --index-url https://download.pytorch.org/whl/cu128

# Install packages that do not depend on Torch first. Ultralytics is installed
# separately with --no-deps so pip cannot replace the pinned cu128 Torch with
# a newer PyPI Torch/CUDA 13 stack.
RUN PYTHONPATH=/opt/difflow-python-packages \
    /isaac-sim/python.sh -m pip install \
      --no-cache-dir \
      --target /opt/difflow-python-packages \
      numpy==1.26.4 \
      warp-lang==${WARP_VERSION} \
      scipy==1.15.3 \
      scikit-learn==1.6.1 \
      joblib==1.4.2 \
      threadpoolctl==3.5.0 \
      tqdm==4.67.1 \
      cffi==1.17.1 \
      pycparser==2.22 \
      pypng==0.20220715.0 \
      PyYAML==6.0.2 \
      Pillow==11.2.1 \
      onnx==1.18.0 \
      onnxslim==0.1.59 \
      matplotlib==3.10.8 \
      opencv-python-headless==4.11.0.86 \
      requests==2.32.5 \
      psutil==7.2.2 \
      polars==1.38.1 \
      nvidia-ml-py==13.590.48 \
      filelock==3.20.3 \
      packaging==25.0 \
      sympy==1.14.0 \
      ftfy \
      regex

RUN PYTHONPATH=/opt/difflow-python-packages \
    /isaac-sim/python.sh -m pip install \
      --no-cache-dir \
      --no-deps \
      --target /opt/difflow-python-packages \
      ultralytics-thop==2.0.18 \
      ultralytics-opencv-headless==${ULTRALYTICS_VERSION}

# YOLOE uses this CLIP package only to encode the text vocabulary before
# exporting the fixed-vocabulary TensorRT engine. --no-deps prevents pip from
# replacing the pinned Torch 2.11.0+cu128 stack.
RUN PYTHONPATH=/opt/difflow-python-packages \
    /isaac-sim/python.sh -m pip install \
      --no-cache-dir \
      --no-deps \
      --target /opt/difflow-python-packages \
      "git+https://github.com/ultralytics/CLIP.git"

# Explicit cu12 package prevents pip from selecting a CUDA 13 TensorRT wheel.
RUN PYTHONPATH=/opt/difflow-python-packages \
    /isaac-sim/python.sh -m pip install \
      --no-cache-dir \
      --target /opt/difflow-python-packages \
      "tensorrt-cu12==${TENSORRT_VERSION}"

COPY --from=difflow-builder /opt/DifFlow3D /opt/DifFlow3D
RUN mkdir -p /usr/local/lib/difflow-cuda
COPY --from=difflow-builder \
    /opt/difflow-cuda-runtime/lib/libcudart.so.12 \
    /usr/local/lib/difflow-cuda/libcudart.so.12

# Register Torch and TensorRT wheel libraries with the dynamic linker.
RUN trt_lib_dir="$(find /opt/difflow-python-packages -type f \
      \( -name 'libnvinfer.so' -o -name 'libnvinfer.so.*' \) \
      -printf '%h\n' | sort -u | head -n 1)" \
    && test -n "${trt_lib_dir}" \
    && printf '%s\n' \
      '/usr/local/lib/difflow-cuda' \
      '/opt/difflow-python-packages/torch/lib' \
      "${trt_lib_dir}" \
      > /etc/ld.so.conf.d/scenepredictor-runtime.conf \
    && ldconfig \
    && ldconfig -p | grep -F 'libcudart.so.12' \
    && ldconfig -p | grep -F 'libnvinfer.so' \
    && test -f /opt/difflow-python-packages/torch/lib/libtorch_python.so

# Append custom paths after Isaac Sim's standard paths.
RUN /isaac-sim/python.sh - <<'PY'
from pathlib import Path
import site

site_dirs = site.getsitepackages()
if not site_dirs:
    raise RuntimeError('Isaac Sim site-packages directory not found')
pth = Path(site_dirs[0]) / 'scenepredictor_paths.pth'
pth.write_text(
    "import sys; "
    "sys.path.insert(0, '/workspace'); "
    "sys.path.insert(0, '/opt/DifFlow3D/pointnet2'); "
    "sys.path.insert(0, '/opt/DifFlow3D'); "
    "sys.path.insert(0, '/opt/difflow-python-packages')\n",
    encoding='utf-8',
)
print('created:', pth)
PY

WORKDIR /workspace

RUN cat > /usr/local/bin/scenepredictor-entrypoint <<'EOF_ENTRYPOINT'
#!/usr/bin/env bash
set -euo pipefail
if [[ -f /opt/ros/jazzy/setup.bash ]]; then
    set +u
    source /opt/ros/jazzy/setup.bash
    set -u
fi
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-117}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
export OMNICLIENT_HUB_MODE="${OMNICLIENT_HUB_MODE:-disabled}"
export HF_HOME="${HF_HOME:-/isaac-sim/.cache/huggingface}"
export TORCH_HOME="${TORCH_HOME:-/isaac-sim/.cache/torch}"
export YOLO_CONFIG_DIR="${YOLO_CONFIG_DIR:-/isaac-sim/.config/Ultralytics}"
exec "$@"
EOF_ENTRYPOINT

RUN chmod +x /usr/local/bin/scenepredictor-entrypoint \
    && cat >> /isaac-sim/.bashrc <<'EOF_BASHRC'
if [[ -f /opt/ros/jazzy/setup.bash ]]; then
    source /opt/ros/jazzy/setup.bash
fi
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-117}"
export RMW_IMPLEMENTATION="${RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
export HF_HOME="${HF_HOME:-/isaac-sim/.cache/huggingface}"
export TORCH_HOME="${TORCH_HOME:-/isaac-sim/.cache/torch}"
export YOLO_CONFIG_DIR="${YOLO_CONFIG_DIR:-/isaac-sim/.config/Ultralytics}"
EOF_BASHRC

# Import validation. GPU availability is not required during docker build.
RUN source /opt/ros/jazzy/setup.bash \
    && YOLO_CONFIG_DIR=/tmp/ultralytics-build-config \
       HF_HOME=/tmp/huggingface-build-cache \
       /isaac-sim/python.sh - <<'PY'
import sys
import clip
import cv2
import numpy
import onnx
import onnxslim
import rclpy
import scipy
import sklearn
import tensorrt as trt
import torch
import torchvision
import ultralytics
import warp as wp
from cv_bridge import CvBridge
from ultralytics import YOLO, YOLOE
import pointnet2_cuda
from pointnet2 import pointnet2_utils

wp.init()
print('Python:', sys.version)
print('Ultralytics CLIP:', clip.__file__)
print('CLIP models:', clip.available_models())
print('numpy:', numpy.__version__)
print('torch:', torch.__version__, 'CUDA:', torch.version.cuda)
print('torchvision:', torchvision.__version__)
print('TensorRT:', trt.__version__)
print('ONNX:', onnx.__version__)
print('ONNX Slim:', onnxslim.__file__)
print('Ultralytics:', ultralytics.__version__)
print('YOLO:', YOLO, 'YOLOE:', YOLOE)
print('OpenCV:', cv2.__version__)
print('Warp:', wp.__version__)
print('ROS:', rclpy.__file__, 'CvBridge:', CvBridge)
print('scipy:', scipy.__version__, 'sklearn:', sklearn.__version__)
print('pointnet2_cuda:', pointnet2_cuda.__file__)
print('pointnet2_utils:', pointnet2_utils.__file__)
PY

RUN install -d -o 1234 -g 1234 -m 0775 \
      /workspace \
      /workspace/camera_output \
      /workspace/weights \
      /isaac-sim/kit/cache \
      /isaac-sim/.cache \
      /isaac-sim/.cache/ov \
      /isaac-sim/.cache/warp \
      /isaac-sim/.cache/matplotlib \
      /isaac-sim/.cache/huggingface \
      /isaac-sim/.cache/torch \
      /isaac-sim/.nv \
      /isaac-sim/.nv/ComputeCache \
      /isaac-sim/.config \
      /isaac-sim/.config/Ultralytics \
      /isaac-sim/.nvidia-omniverse \
      /isaac-sim/.nvidia-omniverse/logs \
      /isaac-sim/.nvidia-omniverse/config \
      /isaac-sim/.local \
      /isaac-sim/.local/share \
      /isaac-sim/.local/share/ov \
      /isaac-sim/.local/share/ov/data \
      /isaac-sim/.local/share/ov/pkg \
    && chown 1234:1234 /isaac-sim/.bashrc \
    && test -r /opt/DifFlow3D/pretrain_weights/model_difflow_355_0.0114.pth \
    && test -r /opt/difflow-python-packages/torch/__init__.py \
    && test -r /opt/difflow-python-packages/warp/__init__.py \
    && test -r /opt/difflow-python-packages/ultralytics/__init__.py \
    && test -r /opt/difflow-python-packages/clip/__init__.py \
    && test -r /opt/difflow-python-packages/tensorrt/__init__.py \
    && test -r /opt/difflow-python-packages/onnx/__init__.py \
    && test -x /opt/ros/jazzy/bin/rviz2

USER 1234:1234
ENTRYPOINT ["/usr/local/bin/scenepredictor-entrypoint"]
CMD ["/bin/bash"]