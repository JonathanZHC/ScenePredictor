Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Name: Background
      Topic:
        Value: /scene_predictor/background_points
      Size (Pixels): 2
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: Static Objects
      Topic:
        Value: /scene_predictor/static_object_points
      Size (Pixels): 3
      Style: Points
    - Class: rviz_default_plugins/PointCloud2
      Name: Moving Objects
      Topic:
        Value: /scene_predictor/moving_object_points
      Size (Pixels): 4
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Name: Predicted Velocity
      Marker Topic:
        Value: /scene_predictor/velocity_markers
    - Class: rviz_default_plugins/Image
      Name: Camera 0 Moving Mask
      Topic:
        Value: /scene_predictor/camera_0/moving_mask
    - Class: rviz_default_plugins/Image
      Name: Camera 1 Moving Mask
      Topic:
        Value: /scene_predictor/camera_1/moving_mask
  Global Options:
    Fixed Frame: world
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
Window Geometry:
  Height: 900
  Width: 1500
